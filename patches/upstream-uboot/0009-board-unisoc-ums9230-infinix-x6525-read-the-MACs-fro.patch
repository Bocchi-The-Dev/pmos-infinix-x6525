From 955fc8a9e1bdf0a33640c55887f64ae1b2c5b265 Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Tue, 3 Nov 2026 05:59:51 +0800
Subject: [PATCH] board: unisoc: ums9230: infinix-x6525: read the MACs from a
 UFS unit's prodnv too

When the mmc prodnv loads leave bdaddr empty, scan the scsi bus and try the
same two files there, so a UFS unit gets its real Bluetooth and Wi-Fi MACs
instead of a random address.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BfvoN2QMhDVD6rSACbEu3p
---
 board/unisoc/ums9230/infinix-x6525.env | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/board/unisoc/ums9230/infinix-x6525.env b/board/unisoc/ums9230/infinix-x6525.env
index 7020eb26..5bdb96c5 100644
--- a/board/unisoc/ums9230/infinix-x6525.env
+++ b/board/unisoc/ums9230/infinix-x6525.env
@@ -6,6 +6,17 @@ preboot=
  if load mmc 0#prodnv 0x9c000000 /wifimac.txt 0x11; then
   mw.b 0x9c000011 0;
   setexpr.s wifiaddr *0x9c000000;
+ fi;
+ if test -z "${bdaddr}"; then
+  scsi scan;
+  if load scsi 0#prodnv 0x9c000000 /btmac.txt 0x11; then
+   mw.b 0x9c000011 0;
+   setexpr.s bdaddr *0x9c000000;
+  fi;
+  if load scsi 0#prodnv 0x9c000000 /wifimac.txt 0x11; then
+   mw.b 0x9c000011 0;
+   setexpr.s wifiaddr *0x9c000000;
+  fi
  fi
 bootcmd=pmicwdt stop; sleep 5; pstore display console; pstore display dump; sleep 15; bootflow scan -lb mmc; bootflow scan -lb scsi; echo === no bootflow: the cache partition ===; part number mmc 0 cache cachenum; echo cache is partition ${cachenum}; ls mmc 0:${cachenum} /; ls mmc 0:${cachenum} /extlinux; echo === no bootflow on scsi: the cache partition ===; part number scsi 0 cache cachenum; echo cache is partition ${cachenum}; ls scsi 0:${cachenum} /; ls scsi 0:${cachenum} /extlinux
 fdt_addr_r=0x9df00000
-- 
