From 8decee34f86c55f1897c2882174ef0af60a45e4e Mon Sep 17 00:00:00 2001
From: ci <a@b>
Date: Tue, 3 Nov 2026 05:51:33 +0800
Subject: [PATCH 68/69] arm64: dts: sprd: infinix-x6525: poll the microSD slot,
 no UHS

U-Boot reads the card without card-detect, but the kernel only reports an SD
host when the detect GPIO says a card is present, and the polarity of
eic_sync 35 was read off an empty slot and never confirmed with a card in.
Poll for the card (broken-cd) and leave the UHS modes off so a failed 1.8 V
switch cannot be what hides the card. Restore cd-gpios and the UHS flags once
the slot is seen to work.

Based on the fix in the Bocchi-The-Dev fork.
---
 .../boot/dts/sprd/ums9230-infinix-x6525.dts      | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
index 3e73391aa..407b1e374 100644
--- a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
+++ b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
@@ -228,15 +228,19 @@ &sdio0 {
 	 * device's own (sdio@201a0000); the vendor's sd-detect-pol-syscon and
 	 * sd-hotplug-* properties are its own and are not in the binding.
 	 */
-	cd-gpios = <&eic_sync 35 GPIO_ACTIVE_LOW>;	/* eic_sync confirmed: the running system */
-							/* has gpio-355 "cd" on the eic-sync chip; the */
-							/* reeder's eic_async is not this board. It read */
-							/* high with the slot empty, so low = card in. */
+	/*
+	 * Card detect is polled (broken-cd) rather than read from eic_sync 35.
+	 * The slot is also a boot path, U-Boot ignores card-detect altogether,
+	 * and that line's polarity (low = card in) was only read off an empty
+	 * slot. Restore cd-gpios = <&eic_sync 35 GPIO_ACTIVE_LOW> once a card has
+	 * been seen to flip it. From the microSD fix in Bocchi-The-Dev's fork.
+	 */
+	broken-cd;
 	vmmc-supply = <&vddsdcore>;
 	vqmmc-supply = <&vddsdio>;
 	bus-width = <4>;
-	sd-uhs-sdr104;
-	sd-uhs-sdr50;
+	/* No UHS modes for now: 3.3 V high-speed only, so a failed 1.8 V switch
+	 * of vddsdio cannot be what hides the card. */
 	no-sdio;
 	no-mmc;
 
