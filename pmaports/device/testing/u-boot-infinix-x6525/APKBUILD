# Reference: <https://postmarketos.org/devicepkg>
maintainer="Seuj09 <jeus110310@gmail.com>"
pkgname=u-boot-infinix-x6525
# Built from the port's own fork of ums9230-mainline/u-boot, branch x6525,
# which is the fork's ums9230 branch plus the board commits (device tree,
# defconfig, environment, the pmicwdt command, the prodnv MAC preboot and UFS boot) --
# the same files this repo carries in uboot/ and patches/upstream-uboot/,
# which is what CI builds. Point url and _commit back at
# codeberg.org/ums9230-mainline/u-boot once the board is merged there.
#
# pkgver is <u-boot version>_git<commit date>, as jolla-c2 does; _commit is the
# x6525 tip. GitHub's commit archives are regenerated on demand, so the hash
# below is for that tarball as fetched today - check it if it ever fails.
pkgver=2025.07_git20261024
pkgrel=7
pkgdesc="U-Boot bootloader for the Infinix X6525"
url="https://github.com/Seuj09/ums9230-mainline-u-boot"
arch="aarch64"
license="GPL-2.0-or-later OFL-1.1 BSD-2-Clause BSD-3-Clause eCos-2.0 IBM-pibs
	ISC LGPL-2.0-only LGPL-2.1-only X11"
makedepends="
	bc
	bison
	dtc
	flex
	openssl-dev
"
_commit="b61233a0e11185fef1b950276986b0c04d5e881c"
source="$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz"
options="!check !tracedeps pmb:cross-native"
# GitHub names the extracted directory <repo>-<commit>
builddir="$srcdir/ums9230-mainline-u-boot-$_commit"

build() {
	make ARCH=arm infinix-x6525_defconfig
	make ARCH=arm
}

package() {
	install -Dm644 "$builddir"/u-boot.bin \
		-t "$pkgdir"/usr/share/u-boot/infinix-x6525
}

sha512sums="
2278098f304a0bfae2fadf14cd73eedb8909dded02176add8f4e6374aa42558da6994b7fe5ebcf3cf07beab796b2fbca1657893cc38aac08e180b1c6afe78cc1  $pkgname-$pkgver.tar.gz
"
